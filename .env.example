# InfraPulse - Copy to .env and adjust
# Phase 1: Infrastructure & Observability

# PostgreSQL
POSTGRES_USER=infrapulse
POSTGRES_PASSWORD=infrapulse_secret
POSTGRES_DB=infrapulse
POSTGRES_PORT=5432

# Prometheus / Loki / Grafana
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001

# Backend ports (when replaced by Phase 2/3 builds)
BACKEND_NODE_PORT=3000
BACKEND_PYTHON_PORT=8000

# App (Phase 2+)
NODE_ENV=development

# Clerk (Phase 2: auth + multi-tenant)
