# InfraPulse - local/development environment
# Never commit real credentials. For production use .env.production (ignored by git).

POSTGRES_USER=infrapulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=infrapulse

PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=http://localhost:3001

BACKEND_NODE_PORT=3000
BACKEND_PYTHON_PORT=8000
NODE_ENV=development

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Internal service authentication
INTERNAL_API_TOKEN=generate-a-long-random-value

# AI & alerting
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RUN_WORKER=1
WORKER_INTERVAL_SECONDS=900
METRICS_LOOKBACK_HOURS=6

# Frontend API base. Empty means same-origin /api.
VITE_API_BASE_URL=
VITE_AI_BASE_URL=

# Optional CORS allow-list for local/dev
CORS_ORIGINS=http://localhost:5173
