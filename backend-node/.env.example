# Backend-node local dev: Prisma and runtime read from this file when you run
# from backend-node/ (e.g. npx prisma db push, npm run dev).
# Copy to .env and set values (or copy from repo root .env).

# Required for Prisma (same as in root when Postgres runs in Docker)
DATABASE_URL="postgresql://infrapulse:infrapulse_secret@localhost:5432/infrapulse"

# Optional: Clerk (for local API dev)
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
