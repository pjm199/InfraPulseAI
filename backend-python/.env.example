# Backend-python local dev. Copy to .env and adjust.
# Must match Postgres: same host/port/user/password as backend-node/.env DATABASE_URL.

DATABASE_URL=postgresql://infrapulse:infrapulse_secret@localhost:5532/infrapulse
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
BACKEND_NODE_URL=http://localhost:3000

# Optional: OpenAI (for /api/chat and AI worker), Telegram (for alerts)
# OPENAI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: RUN_WORKER=0 to disable background worker, WORKER_INTERVAL_SECONDS=900, METRICS_LOOKBACK_HOURS=6
